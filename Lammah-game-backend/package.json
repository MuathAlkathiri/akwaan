{
  "name": "lammah-quiz-backend",
  "version": "1.0.0",
  "description": "Backend for Lammah quiz-party game",
  "author": "Muath",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "configure:gulf-music": "ts-node -r tsconfig-paths/register scripts/configure-gulf-music-category.ts",
    "repair:media-assets": "node dist/scripts/repair-pending-media-assets.js",
    "backfill:category-gameplay-mode": "node dist/scripts/backfill-category-gameplay-mode.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "test:media:integration": "jest --config test/jest-media.json --runInBand",
    "test:fixtures:seed": "ts-node --transpile-only --project tsconfig.test.json -r tsconfig-paths/register test/fixtures/manage-fixtures.ts seed",
    "test:fixtures:reset": "ts-node --transpile-only --project tsconfig.test.json -r tsconfig-paths/register test/fixtures/manage-fixtures.ts reset",
    "test:ai:live": "node scripts/run-live-ai-check.mjs",
    "api:openapi": "NODE_PATH=./node_modules ts-node -r tsconfig-paths/register scripts/generate-openapi.ts",
    "api:validate": "ts-node -r tsconfig-paths/register scripts/validate-openapi.ts",
    "api:offline-check": "node scripts/check-openapi-offline.mjs",
    "api:check": "npm run api:offline-check && npm run api:validate",
    "verify:wigolo": "ts-node -r tsconfig-paths/register scripts/verify-wigolo.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "10.4.22",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.4.2",
    "entities": "^4.5.0",
    "mongoose": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "wigolo": "^0.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
