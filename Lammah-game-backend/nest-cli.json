{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "modules/ai-agent/knowledge/**/*.md",
        "outDir": "dist"
      },
      {
        "include": "modules/ai-agent/knowledge/**/*.json",
        "outDir": "dist"
      }
    ]
  }
}
