# Database Configuration
MONGODB_URI=mongodb://localhost:27017/lammah-quiz

# Server Configuration
PORT=3000
APP_BASE_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

# Optional first admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_FULL_NAME=Admin

# AI Provider
AI_QUESTION_GENERATION_ENABLED=false
AUDIO_AUTO_SELECT_FIRST_CANDIDATE=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-9b:2
LMSTUDIO_API_KEY=dummy
# Local backend process:
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# When the backend runs in Docker, set BACKEND_LM_STUDIO_BASE_URL in the
# repository environment to http://host.docker.internal:1234/v1.
LM_STUDIO_MODEL=qwen/qwen3.5-9b
LM_STUDIO_API_KEY=dummy
AI_REQUEST_TIMEOUT_MS=300000
AI_MAX_TOKENS=4096
AI_RESEARCH_MODEL=
AI_WRITER_MODEL=
AI_REVIEWER_MODEL=
AI_REPAIR_MODEL=
AI_GENERATION_CONCURRENCY=1
OPEN_TRIVIA_DB_BASE_URL=https://opentdb.com
QUESTION_SOURCE_TIMEOUT_MS=15000
AI_GENERATION_BATCH_SIZE=6
AI_BATCH_CONCURRENCY=2
AI_RESEARCH_CONCURRENCY=2
AI_WRITER_CONCURRENCY=3
AI_REVIEW_CONCURRENCY=3
AI_ASSET_CONCURRENCY=2
AI_KNOWLEDGE_TTL_STATIC_SECONDS=2592000
AI_KNOWLEDGE_TTL_SEASONAL_SECONDS=86400
AI_KNOWLEDGE_TTL_LIVE_SECONDS=900
AI_WIKIPEDIA_ENABLED=true
AI_WIKIPEDIA_TIMEOUT_MS=10000
AI_WIKIPEDIA_MAX_RESULTS=5
AI_WIKIPEDIA_MAX_EXTRACT_CHARS=12000
AI_WIKIPEDIA_LANGUAGES=ar,en
AI_WIKIDATA_ENABLED=true
AI_WIKIDATA_TIMEOUT_MS=10000
AI_WIKIDATA_MAX_ENTITIES=10
AI_WIKIDATA_MAX_FACTS_PER_ENTITY=30
AI_MAX_REPAIR_ATTEMPTS=2
# Optional bounded structural diagnostics for accepted-answer responses.
AI_ALIAS_DIAGNOSTICS=false
AI_DUPLICATE_RETRY_ATTEMPTS=2
AI_ENABLE_REWRITE=false
AI_AUDIO_VOICE=Majed

# Local music uploads
UPLOADS_DIR=uploads
MUSIC_QUESTION_CATEGORY_SLUG=songs
MUSIC_DELETE_ORIGINAL_AFTER_SNIPPET=false

# Environment
NODE_ENV=development
# YouTube downloads are development-only by default. Explicitly enable only where permitted.
ALLOW_YOUTUBE_ASSET_DOWNLOADS=false
JIKAN_PROVIDER_ENABLED=true
JIKAN_API_BASE_URL=https://api.jikan.moe/v4
JIKAN_REQUEST_TIMEOUT_MS=10000
JIKAN_CACHE_TTL_MS=86400000
JIKAN_NEGATIVE_CACHE_TTL_MS=600000
JIKAN_MIN_REQUEST_INTERVAL_MS=400

# Optional locally: leave empty to auto-detect node_modules/.bin/wigolo or PATH.
# Docker Compose sets this explicitly to /app/node_modules/.bin/wigolo.
WIGOLO_EXECUTABLE_PATH=
WIGOLO_CACHE_FILE=.cache/entity-verification.json
