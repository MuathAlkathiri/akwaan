# Database Configuration
# LEGACY_PERSISTED_IDENTIFIER: the database is still named `lammah-quiz`. That is
# where the live Akwaan content actually lives — the name predates the rename and
# is deliberately left alone. Changing it here points the app at an empty database.
MONGODB_URI=mongodb://localhost:27017/lammah-quiz

# Server Configuration
PORT=3000
APP_BASE_URL=http://localhost:3000

# Browser origins allowed to call the HTTP API and open a live-session socket.
# Comma-separated, no trailing slash. Development adds localhost automatically;
# production does not, so this must be set on any public deployment.
CORS_ORIGINS=

# Swagger is on by default in development. In production it stays off unless
# this is exactly "true" — the document maps every admin mutation.
SWAGGER_ENABLED=

# Passwordless OTP login
OTP_EXPIRES_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_IDENTIFIER_HOURLY=10
OTP_MAX_REQUESTS_PER_IP_HOURLY=30
# Key for hashing OTPs. Falls back to JWT_SECRET when unset; set it separately
# to rotate OTP hashing without invalidating every issued session token.
OTP_HASH_PEPPER=

# Email delivery (Resend HTTP API). Both are required for email OTP to work.
RESEND_API_KEY=
# Must be an address on a domain verified with the provider, e.g.
# OTP_MAIL_FROM="أكوان <no-reply@your-domain.com>"
OTP_MAIL_FROM=

# Phone/SMS OTP. No provider is integrated, so phone requests return
# SMS_OTP_NOT_AVAILABLE regardless of this flag; it exists so the switch is
# already in place when an adapter lands.
SMS_OTP_ENABLED=false

# JWT Configuration
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

# No admin bootstrap. Nothing automated grants the admin role: register
# normally, then set it by hand once:
#   db.users.updateOne({ email: "you@example.com" }, { $set: { role: "admin" } })

# AI Provider
AI_QUESTION_GENERATION_ENABLED=false
AUDIO_AUTO_SELECT_FIRST_CANDIDATE=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-9b:2
LMSTUDIO_API_KEY=dummy
# Local backend process:
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# When the backend runs in Docker, set BACKEND_LM_STUDIO_BASE_URL in the
# repository environment to http://host.docker.internal:1234/v1.
LM_STUDIO_MODEL=qwen/qwen3.5-9b
LM_STUDIO_API_KEY=dummy
AI_REQUEST_TIMEOUT_MS=300000
AI_MAX_TOKENS=4096
AI_RESEARCH_MODEL=
AI_WRITER_MODEL=
AI_REVIEWER_MODEL=
AI_REPAIR_MODEL=
AI_GENERATION_CONCURRENCY=1
OPEN_TRIVIA_DB_BASE_URL=https://opentdb.com
QUESTION_SOURCE_TIMEOUT_MS=15000
AI_GENERATION_BATCH_SIZE=6
AI_BATCH_CONCURRENCY=2
AI_RESEARCH_CONCURRENCY=2
AI_WRITER_CONCURRENCY=3
AI_REVIEW_CONCURRENCY=3
AI_ASSET_CONCURRENCY=2
AI_KNOWLEDGE_TTL_STATIC_SECONDS=2592000
AI_KNOWLEDGE_TTL_SEASONAL_SECONDS=86400
AI_KNOWLEDGE_TTL_LIVE_SECONDS=900
AI_WIKIPEDIA_ENABLED=true
AI_WIKIPEDIA_TIMEOUT_MS=10000
AI_WIKIPEDIA_MAX_RESULTS=5
AI_WIKIPEDIA_MAX_EXTRACT_CHARS=12000
AI_WIKIPEDIA_LANGUAGES=ar,en
AI_WIKIDATA_ENABLED=true
AI_WIKIDATA_TIMEOUT_MS=10000
AI_WIKIDATA_MAX_ENTITIES=10
AI_WIKIDATA_MAX_FACTS_PER_ENTITY=30
AI_MAX_REPAIR_ATTEMPTS=2
# Optional bounded structural diagnostics for accepted-answer responses.
AI_ALIAS_DIAGNOSTICS=false
AI_DUPLICATE_RETRY_ATTEMPTS=2
AI_ENABLE_REWRITE=false
AI_AUDIO_VOICE=Majed

# Local music uploads
UPLOADS_DIR=uploads

# Durable media mirror (Cloudflare R2, S3-compatible).
# Leave every value empty for local development: uploads then live only on the
# local disk, exactly as before. Set all four to enable mirroring — a partial
# configuration is refused rather than silently half-applied.
# Required on any host with an ephemeral filesystem, such as Render Free.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override; derived from R2_ACCOUNT_ID when empty.
R2_ENDPOINT=
# Public read base for the bucket (r2.dev subdomain or a custom domain).
# When set, /uploads/<key> redirects here for anything not on the local disk.
MEDIA_PUBLIC_BASE_URL=
MUSIC_QUESTION_CATEGORY_SLUG=songs
MUSIC_DELETE_ORIGINAL_AFTER_SNIPPET=false

# Environment
NODE_ENV=development
# YouTube downloads are development-only by default. Explicitly enable only where permitted.
ALLOW_YOUTUBE_ASSET_DOWNLOADS=false
JIKAN_PROVIDER_ENABLED=true
JIKAN_API_BASE_URL=https://api.jikan.moe/v4
JIKAN_REQUEST_TIMEOUT_MS=10000
JIKAN_CACHE_TTL_MS=86400000
JIKAN_NEGATIVE_CACHE_TTL_MS=600000
JIKAN_MIN_REQUEST_INTERVAL_MS=400

# Optional locally: leave empty to auto-detect node_modules/.bin/wigolo or PATH.
# Docker Compose sets this explicitly to /app/node_modules/.bin/wigolo.
WIGOLO_EXECUTABLE_PATH=
WIGOLO_CACHE_FILE=.cache/entity-verification.json
