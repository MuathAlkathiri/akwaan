{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akwaan.local/schemas/rakkibha-contentitem.schema.json",
  "title": "Akwaan Rakkibha ContentItem (visual-assembly)",
  "type": "object",
  "required": [
    "compatibleChallengeTypeIds",
    "prompt",
    "answerPayload",
    "mechanicPayload",
    "status"
  ],
  "properties": {
    "compatibleChallengeTypeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "rakkibha" },
      "items": { "type": "string" }
    },
    "prompt": { "$ref": "#/$defs/localized" },
    "answerPayload": { "type": "object" },
    "status": { "enum": ["draft", "ready", "archived"] },
    "authoring": {
      "type": "object",
      "properties": {
        "rakkibha": {
          "type": "object",
          "required": ["interactionPattern", "runtimeCompatibility", "expectedConversation", "scopeSlug"],
          "properties": {
            "interactionPattern": {
              "enum": [
                "ROUTE_NAVIGATION",
                "SYMBOL_CODE_RECONSTRUCTION",
                "CONSTRAINT_SATISFACTION",
                "DEFUSE_LOGIC",
                "MISSING_PIECE",
                "DISTRIBUTED_ARABIC_NAME_BANK",
                "ODD_SCENE_MATCHING_PAIR",
                "PROPOSED_PATTERN"
              ]
            },
            "runtimeCompatibility": { "enum": ["CURRENT_RUNTIME_COMPATIBLE", "NEEDS_RUNTIME_EXTENSION", "PROPOSED_PATTERN"] },
            "expectedConversation": { "type": "string", "minLength": 20 },
            "scopeSlug": { "type": "string", "minLength": 1 },
            "runtimeBlocker": { "type": "string" },
            "symbolReconstruction": {
              "type": "object",
              "required": ["input", "rule", "operation", "derivedCandidate"],
              "properties": {
                "input": { "type": "string", "minLength": 1 },
                "rule": { "type": "string", "minLength": 1 },
                "operation": { "enum": ["decode", "transform", "derive", "map", "sequence", "reconstruct"] },
                "derivedCandidate": { "type": "string", "minLength": 1 },
                "directVisualCopy": { "const": false }
              }
            },
            "defuseLogic": {
              "type": "object",
              "required": ["device", "contributions"],
              "properties": {
                "device": { "type": "object", "required": ["id", "baselineState", "actionableState"], "properties": { "id": { "type": "string", "minLength": 1 }, "baselineState": { "type": "string", "minLength": 1 }, "actionableState": { "type": "string", "minLength": 1 } } },
                "contributions": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["holderId", "deviceId", "information"], "properties": { "holderId": { "type": "string", "minLength": 1 }, "deviceId": { "type": "string", "minLength": 1 }, "information": { "type": "string", "minLength": 1 } } } }
              }
            },
            "nameBank": {
              "type": "object",
              "properties": {
                "playerLetterSets": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[\u0621-\u064A]$" } } },
                "acceptedNames": { "type": "array", "minItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
                "targetCount": { "const": 9 }
              },
              "required": ["playerLetterSets", "acceptedNames", "targetCount"]
            }
          },
          "allOf": [
            { "if": { "properties": { "interactionPattern": { "const": "SYMBOL_CODE_RECONSTRUCTION" } }, "required": ["interactionPattern"] }, "then": { "required": ["symbolReconstruction"] } },
            { "if": { "properties": { "interactionPattern": { "const": "DEFUSE_LOGIC" } }, "required": ["interactionPattern"] }, "then": { "required": ["defuseLogic"] } }
          ]
        }
      }
    },
    "mechanicPayload": {
      "type": "object",
      "required": [
        "variant",
        "instruction",
        "reference",
        "candidateViews",
        "correctCanonicalIdentity",
        "supportedTeamSizes",
        "authorSafetyConfirmation"
      ],
      "not": {
        "anyOf": [
          { "required": ["segments"] },
          { "required": ["fragments"] },
          { "required": ["twoPlayerMergeOptions"] },
          { "required": ["publicPrompt"] }
        ]
      },
      "properties": {
        "variant": { "const": "visual-assembly" },
        "family": { "const": "visual-assembly" },
        "instruction": { "$ref": "#/$defs/localized" },
        "reference": {
          "type": "object",
          "required": ["media"],
          "properties": {
            "content": { "$ref": "#/$defs/localized" },
            "media": { "$ref": "#/$defs/media" }
          }
        },
        "candidateViews": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "candidates"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "content": { "$ref": "#/$defs/localized" },
              "candidates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": ["localId", "canonicalIdentity", "media"],
                  "properties": {
                    "localId": { "type": "string", "minLength": 1 },
                    "canonicalIdentity": { "type": "string", "minLength": 1 },
                    "content": { "$ref": "#/$defs/localized" },
                    "media": { "$ref": "#/$defs/media" }
                  }
                }
              }
            }
          }
        },
        "correctCanonicalIdentity": { "type": "string", "minLength": 1 },
        "supportedTeamSizes": {
          "type": "array",
          "items": { "enum": [2, 3] },
          "minItems": 2,
          "maxItems": 2
        },
        "authorSafetyConfirmation": { "type": "boolean" },
        "explanation": { "type": "string" }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["ar"],
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      }
    },
    "media": {
      "type": "object",
      "required": ["type", "assets"],
      "properties": {
        "type": { "enum": ["image", "audio", "video"] },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": { "url": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
