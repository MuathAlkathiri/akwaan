# DNS records must point both hosts to the VM public IP before Caddy starts.
FRONTEND_HOST=play.example.net
API_HOST=api.example.net
ACME_EMAIL=admin@example.net

# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Only used when seeding a fresh database. Imported users remain unchanged.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Lammah Admin
