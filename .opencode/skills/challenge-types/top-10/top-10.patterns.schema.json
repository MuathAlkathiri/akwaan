{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lammah://challenge-types/top-10/patterns",
  "title": "Top 10 mechanic payload",
  "oneOf": [
    {
      "title": "Classic",
      "type": "object",
      "properties": { "variant": { "const": "classic" } },
      "additionalProperties": true
    },
    {
      "title": "Poison deck",
      "type": "object",
      "required": [
        "variant",
        "title",
        "rankingBasis",
        "sourceLabel",
        "candidates",
        "rankedAnswer",
        "decoyCandidateIds"
      ],
      "properties": {
        "variant": { "const": "poison-deck" },
        "title": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string" },
        "rankingBasis": { "type": "string", "minLength": 1 },
        "sourceLabel": { "type": "string", "minLength": 1 },
        "asOfDate": { "type": "string", "format": "date" },
        "candidates": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "shortLabel": { "type": "string" },
              "media": {
                "type": "object",
                "required": ["url"],
                "properties": { "url": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "rankedAnswer": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["candidateId", "rank"],
            "properties": {
              "candidateId": { "type": "string", "minLength": 1 },
              "rank": { "type": "integer", "minimum": 1, "maximum": 10 }
            }
          }
        },
        "decoyCandidateIds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  ]
}
