{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akwaan.local/schemas/distributed-information.schema.json",
  "title": "Distributed Information ContentItem",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "scopeId", "compatibleChallengeTypeIds", "patternId", "prompt", "answerMode", "answerPayload", "mechanicPayload", "status", "metadata"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "scopeId": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"},
    "compatibleChallengeTypeIds": {"type": "array", "contains": {"const": "distributed-information"}, "items": {"type": "string"}},
    "patternId": {"const": "three-segment-race"},
    "prompt": {"$ref": "#/$defs/localizedText"},
    "answerMode": {"const": "distributed"},
    "answerPayload": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "acceptedAnswers"], "properties": {"mode": {"const": "match"}, "acceptedAnswers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "correctOptionId", "options"], "properties": {"mode": {"const": "multiple_choice"}, "correctOptionId": {"type": "string", "minLength": 1}, "options": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"$ref": "#/$defs/localizedText"}}}}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "correctValue"], "properties": {"mode": {"const": "closest"}, "correctValue": {"type": "number"}, "acceptedTolerance": {"type": "number", "minimum": 0}}}
      ]
    },
    "mechanicPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["variant", "publicPrompt", "segments", "twoPlayerMergeOptions", "supportedTeamSizes"],
      "properties": {
        "variant": {"const": "three-segment-race"},
        "publicPrompt": {"$ref": "#/$defs/localizedText"},
        "segments": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/segment"}},
        "twoPlayerMergeOptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/merge"}},
        "supportedTeamSizes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": [2, 3]}},
        "authorSafetyConfirmation": {"type": "boolean"},
        "explanation": {"type": "string"}
      }
    },
    "status": {"enum": ["draft", "ready"]},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["sources", "validationStatus", "runtimeContractStatus", "runtimeBlocker"], "properties": {"sources": {"type": "array", "items": {"type": "string"}}, "validationStatus": {"enum": ["draft", "ready"]}, "runtimeContractStatus": {"const": "fully_playable"}, "runtimeBlocker": {"type": "null"}}}
  },
  "$defs": {
    "localizedText": {"type": "object", "additionalProperties": false, "required": ["ar"], "properties": {"ar": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}}},
    "segment": {"type": "object", "additionalProperties": false, "required": ["id", "content"], "properties": {"id": {"enum": ["A", "B", "C"]}, "content": {"$ref": "#/$defs/localizedText"}, "media": {"type": "object"}}},
    "merge": {"type": "object", "additionalProperties": false, "required": ["firstParticipantSegmentIds", "secondParticipantSegmentIds"], "properties": {"firstParticipantSegmentIds": {"type": "array", "items": {"enum": ["A", "B", "C"]}}, "secondParticipantSegmentIds": {"type": "array", "items": {"enum": ["A", "B", "C"]}}}}
  }
}
