{
  "name": "lammah-game-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:admin": "playwright test --grep @admin",
    "test:e2e:game": "playwright test --grep @game",
    "test:e2e:ai": "playwright test --grep @ai",
    "test:e2e:install": "playwright install chromium",
    "api:generate": "orval --config orval.config.ts && node scripts/generated-manifest.mjs --write",
    "api:generate:check": "orval --config orval.config.ts && node scripts/generated-manifest.mjs",
    "api:migration:check": "node scripts/check-catalog-migration.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-query": "^5.28.0",
    "@types/node": "^20.3.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.17",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "next": "^15.1.0",
    "postcss": "^8.4.31",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.48.0",
    "shadcn": "^4.15.0",
    "socket.io-client": "4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^24.1.3",
    "orval": "^7.13.2",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
