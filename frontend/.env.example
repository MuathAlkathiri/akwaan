# Backend origin. Everything else is derived from it: REST calls, `/uploads/...`
# media resolution, and the Socket.IO namespace (https:// upgrades to wss://).
# Local:  http://localhost:3000   (or http://localhost:3002 against Compose)
# BETA:   https://akwaan-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Verbose live-session logging in the browser. Leave unset in production.
NEXT_PUBLIC_LIVE_GAME_DEBUG=
