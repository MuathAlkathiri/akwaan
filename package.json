{
  "name": "akwaan",
  "version": "1.0.0",
  "private": true,
  "description": "Akwaan monorepo: frontend, backend, and AI authoring workspace.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend & wait",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm run lint --workspace frontend",
    "lint:backend": "npm run lint:check --workspace backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run test --workspace frontend",
    "test:frontend:watch": "npm run test:watch --workspace frontend",
    "test:backend": "npm run test --workspace backend -- --passWithNoTests",
    "test:backend:integration": "npm run test:integration --workspace backend",
    "test:backend:integration:docker": "docker compose -f docker-compose.test.yml run --rm backend-integration",
    "test:fixtures:seed": "npm run test:fixtures:seed --workspace backend",
    "test:fixtures:reset": "npm run test:fixtures:reset --workspace backend",
    "test:media:integration": "npm run test:media:integration --workspace backend",
    "test:media:integration:docker": "docker compose -f docker-compose.test.yml --profile media run --rm media-integration",
    "test:ai:live": "npm run test:ai:live --workspace backend",
    "test:e2e:install": "npm run test:e2e:install --workspace frontend",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "test:e2e:ui": "npm run test:e2e:ui --workspace frontend",
    "test:e2e:admin": "npm run test:e2e:admin --workspace frontend",
    "test:e2e:game": "npm run test:e2e:game --workspace frontend",
    "test:e2e:ai": "npm run test:e2e:ai --workspace frontend",
    "api:openapi": "npm run api:openapi --workspace backend",
    "api:validate": "npm run api:validate --workspace backend",
    "api:check": "npm run api:check --workspace backend",
    "api:generate": "npm run api:generate --workspace frontend",
    "api:generate:check": "npm run api:generate:check --workspace frontend",
    "api:migration:check": "npm run api:migration:check --workspace frontend",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run api:check && npm run api:generate:check && npm run api:migration:check && npm run build",
    "verify:full": "npm run verify && npm run test:backend:integration:docker && npm run test:media:integration:docker && npm run test:e2e"
  },
  "devDependencies": {
    "@nestjs/platform-express": "10.4.22"
  }
}
